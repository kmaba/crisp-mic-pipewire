[Unit]
Description=Assert Crisp Mic output volumes (Pebbles analog jack 100%%, mic +8dB)
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'while true; do /usr/bin/pactl set-sink-volume pebble_out 100%% 2>/dev/null; /usr/bin/pactl set-sink-volume alsa_output.pci-0000_06_00.6.analog-stereo 100%% 2>/dev/null; /usr/bin/pactl set-source-volume mic_crisp 6.5dB 2>/dev/null; sleep 5; done'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
